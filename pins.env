# Canonical pin source for trtllm-deepep-v2-efa.
#
# Wave 33: switched to NGC base so the torch 2.11.0a0 ABI matches
# trtllm 1.3.0rc14's compiled libth_common.so (4-arg MessageLogger ctor).
# See sibling antonai-work/deepep-v2-efa-base-ngc for the NGC variant
# and the parent deepep-v2-integration/docs/wave32-evidence/
# trtllm-ngc-pivot-analysis.md for the full ABI diff.
# NGC-variant base is pushed to ECR (not GHCR) by deepep-v2-efa-base-ngc-build.
# Account 058264135704 / us-east-2 is the canonical registry for this tree.
export BASE_IMAGE_FAST="058264135704.dkr.ecr.us-east-2.amazonaws.com/deepep-v2-efa-base-ngc:v0.3.0-sm90a-ngc-amd64"
export DEEPEP_FORK="https://github.com/deepseek-ai/DeepEP.git"
export DEEPEP_BRANCH="aws-efa-auto-qp-cap-v2"
export DEEPEP_SHA="146cc356aa00c39ac1590c05775e05b0f031e70c"
export NVIDIA_NCCL_PIN="2.30.4"
export NVSHMEM_PIN="3.6.5"
# TRT-LLM 1.3.0rc14 from NVIDIA PyPI. Must match the NGC base's torch ABI.
export TRTLLM_VERSION="1.3.0rc14"
export TRTLLM_INDEX="https://pypi.nvidia.com"
